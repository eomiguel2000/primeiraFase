programa {
  funcao inicio() {
    //entendimento do poblema
    //calcule quantas laranjas foram vendidas no dia
    //infos e variaveis
    inteiro quantidade
    inteiro inicial, final

    //entrada de dados
    escreva("quantidade inicial: ")
    leia(inicial)
    escreva("quantidade final: ")
    leia(final)
  //processamento
  quantidade = inicial - final
  //saida
  escreva("quantas laranjas foram vendidas no dia?: ")
  escreva(quantidade)
  

    
    
  }
}
