programa {
  funcao inicio() {
    //entendimento do poblema
    // ler a quantidade de pessoas e calcular a quantidade de produtos para comprar
    //infos e variaveis
    inteiro pessoas
    real carne, cerveja, agua, refri
    //entrada de dados
     escreva("quantas pessoas tem?:")
    leia(pessoas)
    //processamento
    carne = pessoas * 0.5
    cerveja = pessoas * 1
    agua = pessoas * 0.5
    refri = pessoas * 0.2
    //saida
    escreva("\ncarne: " + carne)
    escreva("\ncerveja:" + cerveja)
    escreva("\nagua:" + agua)
    escreva("\nrefri:" + refri)




    
    
  }
}
