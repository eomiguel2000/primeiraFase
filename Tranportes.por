programa {
  funcao inicio() {
    //entendimento do poblema
    //calcular o peso da balança e a tara e calcule o peso da carga que o caminhão está carregando.
    //infos e variaveis
    real peso, balanca, tara
    real carga
    //entrada de dados
    escreva("digite qual é o peso da balança:?")
    leia(balanca)
   escreva("digite qual é a tara:? ")
   leia(tara)
    escreva("digite qual é o peso:?")
    leia(peso)
    //processamento
     carga=peso-tara
    
    //saida
     escreva(" peso da carga que o caminhão está carregando:Kg", carga)
    
    



  }
}
