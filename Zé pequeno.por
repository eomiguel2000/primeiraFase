programa {
  funcao inicio() {
    // entendimento do poblema


    //calcular o valor de vale trocas, considerando preço e quantidade

    //infos e variaveis 
    real valeTroca, preco
    inteiro quantidade
    // entrada de dados
    escreva(" preço do par do calçado: ")
    leia(preco)

    

    escreva(" quantidade de pares trocados: ")
    leia(quantidade)

    // processamento
    valeTroca = preco * quantidade


    // saidas
    escreva("valor de troca é: ")
    escreva(valeTroca)

  }
}
