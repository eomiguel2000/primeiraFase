programa {
  funcao inicio() {
    //entendimento do poblema
    //calcule quanto recebe por dia de trabalho neste seu primeiro trabalho de dev
    //info e variaveis
    real mensal
    real dias
    real valor
    inteiro semana

    //entrada de dados
    escreva("salario mensal: ")
    leia(mensal)
    escreva("dias trabalhados: ")
    leia(dias)

    //processamento
    semana = 5 
    valor = mensal / dias * 5 

    


    //saida
    escreva("salario semanal é?: ")
    escreva(valor)
    
    
    
  }
}
