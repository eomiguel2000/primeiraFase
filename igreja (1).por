programa {
  funcao inicio() {
    //entendimento do poblema
    //calcule quanto falta para pagar completamente os custos mensais
    //info e variaveis
    real custos 
    real doacoes
    real falta
    

    //estrada de dados
    escreva("custos mensais: ")
    leia(custos)
    escreva("doacoes e dizimo no dia: ")
    leia(doacoes)


    //processamento
    falta = custos - doacoes

    //saida 
    escreva("quanto falta para pagar completamente os custos mensais?: ")
    escreva(falta)



  
    
  }
}
